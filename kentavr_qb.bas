'QB program based on source 1981
CLS

Dim col=RGB(0,255,0)
Dim integer x0,y0

    For v = 0 To 2
      For u = 0 To 2
' for thick line remove two loops
        Restore arcs
        For i = 1 To 102
          Read sx,sy,sr,sa,sb
          Arc_(sx/2 + u, sy/2 + v, sr/2, sa, sb)
        Next i
        'lines
Line 130/2 + u, 404/2 + v,92/2 + u,443/2 + v, 1,col
Line 92/2 + u, 443/2 + v,97/2 + u, 433/2 + v, 1,col
Line 92/2 + u, 443/2 + v,101/2 + u, 440/2 + v, 1,col
Line 99/2 + u, 410/2 + v,128/2 + u, 436/2 + v,1, col
Line 423/2 + u, 207/2 + v,526/2 + u, 248/2 + v,1, col
Line 526/2 + u, 248/2 + v,512/2 + u, 234/2 + v,1, col
Line 526/2 + u, 248/2 + v,507/2 + u, 248/2 + v,1, col
star(254/2 + u, 366/2 + v)
star(100/2 + u, 108/2 + v)
star(372/2 + u, 22/2 + v)
      Next u
    Next v

End
Sub arc_(x, y, r, raStart, raStop)
Local a
    If raStop < raStart Then
        Arc_(x, y, r, raStart, Pi*2)
        Arc_(x, y, r, 0, raStop)
    Else
        ' modified to easier way suggested by Steve
        'Why was the line method not good? I forgot.
aStep = 1 / (Pi * r * r *(raStop - raStart) / (Pi*2))
        For a = raStart To raStop Step aStep
Pixel x+r*Cos(2*Pi-a),y+r*Sin(2*Pi-a),col
        Next a
    EndIf
End Sub

Sub linestep(dx,dy)
  Line x0,y0,x0+dx/2,y0+dy/2,1,col
  x0=x0+dx/2
  y0=y0+dy/2
End Sub
Sub star(xo,yo)
  x0=xo
  y0=yo
  LINeStep(4, 26)
  LINEStep(46, -2)
  LINEStep(-48, 18)
  LINEStep(-14, 43)
  LINEStep(-2, -45)
  LINEStep(-14, -2)
  LINEStep(14, -8)
  LINEStep(14, -28)
End Sub

