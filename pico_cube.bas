'Pico cube
CLS
Dim co(4)
co(1)=RGB(0,0,255)
co(2)=RGB(0,255,0)
co(3)=RGB(255,0,0)
Font 8
Color &H1f1f1f
Print @(0,0) " Pico"
For y=6 To 0 Step -1
For x=4 To 20
cc=Pixel(x,y)
If cc<>0 Then
Restore cube
For cy=0 To 31
Read cu$
For cx=1 To 32
cc=Val(Mid$(cu$,cx,1))
If cc<>0 Then
Pixel x*15+cx-31,10+y*14+x*8+cy,co(cc)
End If
Next cx
Next cy
End If
Next x
Next y
'Save image"cube.bmp"
